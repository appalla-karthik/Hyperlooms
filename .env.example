# Local development only. Never use these values in a shared or public environment.
HYPERLOOMS_POSTGRES_DB=hyperlooms
HYPERLOOMS_POSTGRES_USER=hyperlooms
HYPERLOOMS_POSTGRES_PASSWORD=local-development-only
HYPERLOOMS_POSTGRES_PORT=5432

HYPERLOOMS_S3_ACCESS_KEY=hyperlooms-local
HYPERLOOMS_S3_SECRET_KEY=local-development-only-change-me
HYPERLOOMS_S3_API_PORT=9000
HYPERLOOMS_S3_ADMIN_PORT=9001
HYPERLOOMS_ARTIFACT_BUCKET=hyperlooms-artifacts

HYPERLOOMS_CONTROL_PLANE_PORT=8080
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:8080

HYPERLOOMS_AGENT_ID=local-agent
HYPERLOOMS_AGENT_HEALTH_ADDRESS=127.0.0.1:9091
HYPERLOOMS_LOG_LEVEL=INFO
