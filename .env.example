# Local development only. Never use these values in a shared or public environment.
HYPERLOOMS_POSTGRES_DB=hyperlooms
HYPERLOOMS_POSTGRES_USER=hyperlooms
HYPERLOOMS_POSTGRES_PASSWORD=local-development-only
HYPERLOOMS_POSTGRES_PORT=5432

HYPERLOOMS_S3_ACCESS_KEY=hyperlooms-local
HYPERLOOMS_S3_SECRET_KEY=local-development-only-change-me
HYPERLOOMS_S3_API_PORT=9000
HYPERLOOMS_S3_ADMIN_PORT=9001
HYPERLOOMS_ARTIFACT_BUCKET=hyperlooms-artifacts

HYPERLOOMS_CONTROL_PLANE_PORT=8080
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:8080
# Requester console server-only configuration. Generate a fresh 32-byte base64 key;
# never commit it. Loopback HTTP requires the explicit local-only flag.
HYPERLOOMS_WEB_ORIGIN=http://localhost:3000
HYPERLOOMS_WEB_API_ORIGIN=http://localhost:8080
HYPERLOOMS_WEB_OIDC_ISSUER=http://localhost:8180/realms/hyperlooms-dev
HYPERLOOMS_WEB_OIDC_CLIENT_ID=hyperlooms-local-client
HYPERLOOMS_WEB_SESSION_KEY=
HYPERLOOMS_WEB_ALLOW_INSECURE_LOCAL=false

# Requester API is off until a real OIDC issuer and dedicated API audience exist.
# HTTPS issuer/JWKS URLs and signed Bearer tokens are required when enabled.
HYPERLOOMS_REQUESTER_API_ENABLED=false
HYPERLOOMS_REQUESTER_ISSUER_URI=
HYPERLOOMS_REQUESTER_JWK_SET_URI=
HYPERLOOMS_REQUESTER_AUDIENCE=
# Local Keycloak start-dev only. Never enable with a non-loopback HTTP issuer.
HYPERLOOMS_REQUESTER_ALLOW_INSECURE_LOCAL_ISSUER=false
HYPERLOOMS_IDENTITY_ADMIN_USER=admin
HYPERLOOMS_IDENTITY_ADMIN_PASSWORD=local-development-only-change-me
# Only for the local S3-compatible service; production should use HTTPS and
# workload identity/default AWS credential chain rather than static keys.
HYPERLOOMS_S3_ENDPOINT=http://localhost:9000
HYPERLOOMS_S3_PATH_STYLE=true
HYPERLOOMS_S3_ALLOW_INSECURE_LOCAL=true
HYPERLOOMS_S3_REGION=us-east-1

# Opt-in control-plane reconciliation only; does not start GPU work or retries.
HYPERLOOMS_LEASE_EXPIRY_ENABLED=false
HYPERLOOMS_LEASE_EXPIRY_POLL_INTERVAL_MS=5000

# Experimental claim polling is OFF until executable agent commands and recovery exist.
# Turning it on can lease jobs, but cannot execute them yet.
HYPERLOOMS_SCHEDULER_ENABLED=false
HYPERLOOMS_SCHEDULER_POLL_INTERVAL_MS=5000

# Disabled until operator-issued server/client certificates and a trusted CA exist.
HYPERLOOMS_AGENT_GRPC_ENABLED=false
HYPERLOOMS_AGENT_GRPC_PORT=9090
HYPERLOOMS_AGENT_GRPC_CERTIFICATE=
HYPERLOOMS_AGENT_GRPC_PRIVATE_KEY=
HYPERLOOMS_AGENT_GRPC_CLIENT_CA=
# Internal test gate only: sends a prepared command for durable staging, never execution.
# Keep false outside controlled integration tests.
HYPERLOOMS_AGENT_COMMAND_STAGING_ENABLED=false
# Internal mTLS input transfer on both server and agent; requires requester storage.
# Without the separate execution gate it validates then discards the input.
HYPERLOOMS_AGENT_INPUT_READ_ENABLED=false
# Both endpoints must be enabled only on a qualified host with an approved recipe.
# Certificate/fencing-bound execution, renewal and result upload are otherwise denied.
HYPERLOOMS_AGENT_EXECUTION_ENABLED=false

HYPERLOOMS_AGENT_ID=local-agent
HYPERLOOMS_AGENT_HEALTH_ADDRESS=127.0.0.1:9091
HYPERLOOMS_LOG_LEVEL=INFO

# Set all of these to enable the outbound provider session on a Linux NVIDIA host.
HYPERLOOMS_AGENT_GRPC_ADDRESS=
HYPERLOOMS_AGENT_NODE_ID=
HYPERLOOMS_AGENT_SERVER_CA=
HYPERLOOMS_AGENT_CLIENT_CERT=
HYPERLOOMS_AGENT_CLIENT_KEY=
HYPERLOOMS_AGENT_STATE_DIR=
# Experimental: only on a qualified Linux amd64 Docker host. Removes this node's
# verified, orphaned Hyperlooms containers before the outbound session starts.
HYPERLOOMS_AGENT_RUNTIME_RECOVERY_ENABLED=false
